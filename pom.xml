<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>br.com.aluguelcarros</groupId>
    <artifactId>aluguel-carros-teste-estrutural</artifactId>
    <version>1.0-SNAPSHOT</version>

    <properties>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <junit.jupiter.version>5.11.4</junit.jupiter.version>
        <assertj.version>3.27.6</assertj.version>
        <jacoco.version>0.8.12</jacoco.version>
        <pitest.version>1.17.3</pitest.version>
        <pitest.junit5.version>1.2.1</pitest.junit5.version>
        <python.executable>python3</python.executable>
        <test.group>suite</test.group>
        <experiment.target>sem-perfil</experiment.target>
        <tests.required>false</tests.required>
        <tests.include>**/*Test.java,**/*Teste.java</tests.include>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.jupiter.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>${assertj.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
                <configuration>
                    <failIfNoTests>${tests.required}</failIfNoTests>
                    <includes><include>${tests.include}</include></includes>
                    <reportsDirectory>${project.build.directory}/surefire-reports/${test.group}</reportsDirectory>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>aluguel-completa</id>
            <properties>
                <test.group>aluguel-completa</test.group>
                <tests.include>br/com/aluguelcarros/SuiteCompleta.java</tests.include>
                <tests.required>true</tests.required>
                <experiment.test>br.com.aluguelcarros.SuiteCompleta</experiment.test>
                <experiment.target>br.com.aluguelcarros.CalculadoraCustoLocacao</experiment.target>
                <experiment.classes>br/com/aluguelcarros/CalculadoraCustoLocacao*.class</experiment.classes>
            </properties>
        </profile>
        <profile>
            <id>aluguel-sem-codigo</id>
            <properties>
                <test.group>aluguel-sem-codigo</test.group>
                <tests.include>br/com/aluguelcarros/SuiteSemCodigo.java</tests.include>
                <tests.required>true</tests.required>
                <experiment.test>br.com.aluguelcarros.SuiteSemCodigo</experiment.test>
                <experiment.target>br.com.aluguelcarros.CalculadoraCustoLocacao</experiment.target>
                <experiment.classes>br/com/aluguelcarros/CalculadoraCustoLocacao*.class</experiment.classes>
            </properties>
        </profile>
        <profile>
            <id>aluguel-sem-especificacao</id>
            <properties>
                <test.group>aluguel-sem-especificacao</test.group>
                <tests.include>br/com/aluguelcarros/SuiteSemEspecificacao.java</tests.include>
                <tests.required>true</tests.required>
                <experiment.test>br.com.aluguelcarros.SuiteSemEspecificacao</experiment.test>
                <experiment.target>br.com.aluguelcarros.CalculadoraCustoLocacao</experiment.target>
                <experiment.classes>br/com/aluguelcarros/CalculadoraCustoLocacao*.class</experiment.classes>
            </properties>
        </profile>
        <profile>
            <id>aluguel-sem-analise</id>
            <properties>
                <test.group>aluguel-sem-analise</test.group>
                <tests.include>br/com/aluguelcarros/SuiteSemAnalise.java</tests.include>
                <tests.required>true</tests.required>
                <experiment.test>br.com.aluguelcarros.SuiteSemAnalise</experiment.test>
                <experiment.target>br.com.aluguelcarros.CalculadoraCustoLocacao</experiment.target>
                <experiment.classes>br/com/aluguelcarros/CalculadoraCustoLocacao*.class</experiment.classes>
            </properties>
        </profile>
        <profile>
            <id>poquer-completa</id>
            <properties>
                <test.group>poquer-completa</test.group>
                <tests.include>br/com/poquer/SuiteCompleta.java</tests.include>
                <tests.required>true</tests.required>
                <experiment.test>br.com.poquer.SuiteCompleta</experiment.test>
                <experiment.target>br.com.poquer.Mao</experiment.target>
                <experiment.classes>br/com/poquer/Mao*.class</experiment.classes>
            </properties>
        </profile>
        <profile>
            <id>poquer-sem-codigo</id>
            <properties>
                <test.group>poquer-sem-codigo</test.group>
                <tests.include>br/com/poquer/SuiteSemCodigo.java</tests.include>
                <tests.required>true</tests.required>
                <experiment.test>br.com.poquer.SuiteSemCodigo</experiment.test>
                <experiment.target>br.com.poquer.Mao</experiment.target>
                <experiment.classes>br/com/poquer/Mao*.class</experiment.classes>
            </properties>
        </profile>
        <profile>
            <id>poquer-sem-especificacao</id>
            <properties>
                <test.group>poquer-sem-especificacao</test.group>
                <tests.include>br/com/poquer/SuiteSemEspecificacao.java</tests.include>
                <tests.required>true</tests.required>
                <experiment.test>br.com.poquer.SuiteSemEspecificacao</experiment.test>
                <experiment.target>br.com.poquer.Mao</experiment.target>
                <experiment.classes>br/com/poquer/Mao*.class</experiment.classes>
            </properties>
        </profile>
        <profile>
            <id>poquer-sem-analise</id>
            <properties>
                <test.group>poquer-sem-analise</test.group>
                <tests.include>br/com/poquer/SuiteSemAnalise.java</tests.include>
                <tests.required>true</tests.required>
                <experiment.test>br.com.poquer.SuiteSemAnalise</experiment.test>
                <experiment.target>br.com.poquer.Mao</experiment.target>
                <experiment.classes>br/com/poquer/Mao*.class</experiment.classes>
            </properties>
        </profile>
        <profile>
            <id>academico-completa</id>
            <properties>
                <test.group>academico-completa</test.group>
                <tests.include>br/com/academico/SuiteCompleta.java</tests.include>
                <tests.required>true</tests.required>
                <experiment.test>br.com.academico.SuiteCompleta</experiment.test>
                <experiment.target>br.com.academico.ConsolidacaoParcial</experiment.target>
                <experiment.classes>br/com/academico/ConsolidacaoParcial*.class</experiment.classes>
            </properties>
        </profile>
        <profile>
            <id>academico-sem-codigo</id>
            <properties>
                <test.group>academico-sem-codigo</test.group>
                <tests.include>br/com/academico/SuiteSemCodigo.java</tests.include>
                <tests.required>true</tests.required>
                <experiment.test>br.com.academico.SuiteSemCodigo</experiment.test>
                <experiment.target>br.com.academico.ConsolidacaoParcial</experiment.target>
                <experiment.classes>br/com/academico/ConsolidacaoParcial*.class</experiment.classes>
            </properties>
        </profile>
        <profile>
            <id>academico-sem-especificacao</id>
            <properties>
                <test.group>academico-sem-especificacao</test.group>
                <tests.include>br/com/academico/SuiteSemEspecificacao.java</tests.include>
                <tests.required>true</tests.required>
                <experiment.test>br.com.academico.SuiteSemEspecificacao</experiment.test>
                <experiment.target>br.com.academico.ConsolidacaoParcial</experiment.target>
                <experiment.classes>br/com/academico/ConsolidacaoParcial*.class</experiment.classes>
            </properties>
        </profile>
        <profile>
            <id>academico-sem-analise</id>
            <properties>
                <test.group>academico-sem-analise</test.group>
                <tests.include>br/com/academico/SuiteSemAnalise.java</tests.include>
                <tests.required>true</tests.required>
                <experiment.test>br.com.academico.SuiteSemAnalise</experiment.test>
                <experiment.target>br.com.academico.ConsolidacaoParcial</experiment.target>
                <experiment.classes>br/com/academico/ConsolidacaoParcial*.class</experiment.classes>
            </properties>
        </profile>
        <profile>
            <id>medir</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.jacoco</groupId>
                        <artifactId>jacoco-maven-plugin</artifactId>
                        <version>${jacoco.version}</version>
                        <configuration>
                            <includes><include>${experiment.classes}</include></includes>
                            <destFile>${project.build.directory}/jacoco-${test.group}.exec</destFile>
                            <dataFile>${project.build.directory}/jacoco-${test.group}.exec</dataFile>
                            <append>false</append>
                            <outputDirectory>${project.build.directory}/site/jacoco/${test.group}</outputDirectory>
                        </configuration>
                        <executions>
                            <execution>
                                <id>instrumentar-experimento</id>
                                <goals><goal>prepare-agent</goal></goals>
                                <configuration combine.self="override">
                                    <destFile>${project.build.directory}/jacoco-${test.group}.exec</destFile>
                                    <append>false</append>
                                </configuration>
                            </execution>
                            <execution>
                                <id>relatar-experimento</id>
                                <phase>verify</phase>
                                <goals><goal>report</goal></goals>
                                <configuration>
                                    <formats><format>HTML</format><format>XML</format></formats>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-maven</artifactId>
                        <version>${pitest.version}</version>
                        <dependencies>
                            <dependency>
                                <groupId>org.pitest</groupId>
                                <artifactId>pitest-junit5-plugin</artifactId>
                                <version>${pitest.junit5.version}</version>
                            </dependency>
                        </dependencies>
                        <configuration>
                            <targetClasses><param>${experiment.target}</param></targetClasses>
                            <targetTests><param>${experiment.test}</param></targetTests>
                            <reportsDirectory>${project.build.directory}/pit-reports/${test.group}</reportsDirectory>
                            <mutators><mutator>DEFAULTS</mutator></mutators>
                            <outputFormats><param>HTML</param><param>XML</param></outputFormats>
                            <timestampedReports>false</timestampedReports>
                        </configuration>
                        <executions>
                            <execution>
                                <id>mutar-experimento</id>
                                <phase>verify</phase>
                                <goals><goal>mutationCoverage</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>tsdetect</id>
            <build><plugins><plugin>
                <groupId>org.codehaus.mojo</groupId><artifactId>exec-maven-plugin</artifactId><version>3.5.0</version>
                <executions><execution>
                    <id>detect-test-smells</id><phase>verify</phase><goals><goal>exec</goal></goals>
                    <configuration>
                        <executable>${python.executable}</executable>
                        <arguments>
                            <argument>${project.basedir}/scripts/quality.py</argument>
                            <argument>tsdetect</argument>
                            <argument>${test.group}</argument>
                            <argument>${tests.include}</argument>
                            <argument>${experiment.target}</argument>
                        </arguments>
                    </configuration>
                </execution></executions>
            </plugin></plugins></build>
        </profile>
    </profiles>
</project>
